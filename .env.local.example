# Copy this file to .env.local and adjust as needed.

# Base URL of the RezuLens backend API. Defaults to http://127.0.0.1:8000
# in code if unset, so this only needs to be set when pointing at a
# non-default backend (a different port, or a deployed instance).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
